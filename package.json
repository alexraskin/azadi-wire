{
	"name": "azadiwire",
	"type": "module",
	"version": "0.0.2",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && node scripts/patch-worker.mjs",
		"preview": "npm run build && wrangler dev -c dist/server/wrangler.json",
		"astro": "astro",
		"test": "vitest run",
		"test:watch": "vitest",
		"deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
		"cf-typegen": "wrangler types",
		"migrate": "wrangler d1 migrations apply azadi-wire-db --remote",
		"migrate-local": "wrangler d1 migrations apply azadi-wire-db --local",
    "staging": "npm run build && wrangler versions upload -c dist/server/wrangler.json --preview-alias staging"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.2.0",
		"@astrojs/rss": "^4.0.15",
		"@astrojs/sitemap": "^3.7.0",
		"astro": "^7.2.0",
		"he": "^1.2.0",
		"resend": "^6.9.3"
	},
	"devDependencies": {
		"@types/node": "^25.3.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.69.0"
	}
}
