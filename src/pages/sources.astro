---
import Base from '../layouts/Base.astro';
import { getAllSources, getReadDB } from '../lib/db';
import type { Source } from '../lib/types';
import { env } from 'cloudflare:workers';
import { NO_STORE } from '../lib/cache';

const db = getReadDB(env);

let sources: Source[] = [];
let fetchError = false;
try {
  sources = await getAllSources(db);
} catch {
  fetchError = true;
}

// The error state is a transient database failure, not content. Keep it out of
// the edge cache so the page recovers on the next request.
if (fetchError) {
  Astro.response.headers.set('Cache-Control', NO_STORE);
}
---

<Base title="Sources" description="News sources aggregated by Azadi Wire — 20+ independent outlets covering Iran.">
  <h1 class="page-title">Sources</h1>
  {fetchError ? (
    <p>Unable to load sources right now. Please try again later.</p>
  ) : (
    <ul class="source-list">
      {sources.map((source) => (
        <li class="source-item">
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            {source.name}
          </a>
          <span class="badge">{source.type.toUpperCase()}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
